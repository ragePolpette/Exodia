#!/usr/bin/env sh
set -eu

msg_file="$1"
msg="$(cat "$msg_file")"

fail() {
  echo "Commit message blocked by Exodia policy: $1" >&2
  echo "Use a generic technical message and keep customer/runtime data out of Git history." >&2
  exit 1
}

printf '%s\n' "$msg" | grep -Eiq '[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}' && fail "email address detected"
printf '%s\n' "$msg" | grep -Eiq 'https?://|www\.' && fail "URL detected"
printf '%s\n' "$msg" | grep -Eiq '(^|[^A-Za-z])(C:|D:|E:)\\' && fail "local Windows path detected"
printf '%s\n' "$msg" | grep -Eiq 'partita iva|p\.?iva|codice fiscale|tax id|vat|telefono|tel\.|phone' && fail "personal/company identifier wording detected"
printf '%s\n' "$msg" | grep -Eiq 'cliente|customer|fornitore|supplier|azienda|company' && fail "customer/business entity wording detected"
printf '%s\n' "$msg" | grep -Eiq '[0-9]{11}' && fail "11-digit identifier detected"
printf '%s\n' "$msg" | grep -Eiq '[A-Z]{6}[0-9]{2}[A-Z][0-9]{2}[A-Z][0-9]{3}[A-Z]' && fail "Italian fiscal-code-like identifier detected"
printf '%s\n' "$msg" | grep -Eiq 'sk-[A-Za-z0-9_-]{20,}|gh[pousr]_[A-Za-z0-9_]{20,}|xox[baprs]-[A-Za-z0-9-]{20,}' && fail "token-like value detected"

exit 0

