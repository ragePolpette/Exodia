#!/usr/bin/env sh
set -eu

fail() {
  echo "Commit blocked by Exodia policy: $1" >&2
  echo "Remove or redact sensitive content before committing." >&2
  exit 1
}

ensure_policy_file() {
  if [ -f "COMMIT_AND_SECRET_POLICY.md" ] || [ -f "policy/COMMIT_AND_SECRET_POLICY.md" ] || [ -f "policy/COMMIT_AND_SECRET_POLICY.example.md" ]; then
    return
  fi

  template_file="$(git rev-parse --git-dir)/COMMIT_AND_SECRET_POLICY.md"
  if [ ! -f "$template_file" ]; then
    template_root="$(git config --global --get init.templateDir || true)"
    if [ -n "$template_root" ] && [ -f "$template_root/COMMIT_AND_SECRET_POLICY.md" ]; then
      template_file="$template_root/COMMIT_AND_SECRET_POLICY.md"
    fi
  fi

  if [ -f "$template_file" ]; then
    cp "$template_file" COMMIT_AND_SECRET_POLICY.md
    fail "policy file was missing; created COMMIT_AND_SECRET_POLICY.md, review it and stage it"
  fi

  fail "missing COMMIT_AND_SECRET_POLICY.md"
}

ensure_policy_file

staged_files="$(git diff --cached --name-only --diff-filter=ACMR)"

printf '%s\n' "$staged_files" | grep -Eiq '^(data|logs|artifacts|transcripts|memory)(/|$)' && fail "generated data/log/memory path staged"
printf '%s\n' "$staged_files" | grep -Eiq '(^|/)(\.env|\.env\..*|.*\.private\.(json|toml|config)|.*\.local\.(json|toml|config))$' && fail "local/private config staged"
printf '%s\n' "$staged_files" | grep -Eiq '(^|/).*\.(pfx|pem|key|crt|cer|p12)$' && fail "certificate/key file staged"

for file in $staged_files; do
  [ -f "$file" ] || continue

  case "$file" in
    .githooks/*)
      continue
      ;;
    COMMIT_AND_SECRET_POLICY.md|policy/COMMIT_AND_SECRET_POLICY.md|policy/COMMIT_AND_SECRET_POLICY.example.md)
      continue
      ;;
    package-lock.json|*.png|*.jpg|*.jpeg|*.gif|*.ico|*.pdf|*.zip|*.dll|*.exe)
      continue
      ;;
  esac

  content="$(git show ":$file" 2>/dev/null || true)"
  [ -n "$content" ] || continue

  printf '%s\n' "$content" | grep -Eiq 'sk-[A-Za-z0-9_-]{20,}|gh[pousr]_[A-Za-z0-9_]{20,}|xox[baprs]-[A-Za-z0-9-]{20,}' && fail "token-like value in $file"
  printf '%s\n' "$content" | grep -Eiq 'password\s*=|passwd\s*=|pwd\s*=|client_secret\s*[:=]\s*["'\''][^"'\'']+|connectionstring\s*[:=]\s*["'\''][^"'\'']+|connection string\s*[:=]\s*["'\''][^"'\'']+' && fail "secret keyword in $file"
  printf '%s\n' "$content" | grep -Eiq '[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}' && fail "email address in $file"
  if printf '%s\n' "$content" | grep -Eiq '(^|[^A-Za-z])(C:|D:|E:)\\'; then
    if printf '%s\n' "$content" | grep -Eiv 'C:[\\]+path[\\]+to|C:[\\]+temp|C:[\\]+tmp|C:[\\]+repo|C:[\\]+pi' | grep -Eiq '(^|[^A-Za-z])(C:|D:|E:)\\'; then
      fail "local Windows path in $file"
    fi
  fi
  printf '%s\n' "$content" | grep -Eiq 'partita iva|p\.?iva|codice fiscale|telefono|tel\.|tax id|vat number' && fail "personal/company identifier wording in $file"
done

exit 0
